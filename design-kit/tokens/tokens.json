{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Simcc Design Kit — tokens da área pública. Fonte: estética atual da plataforma (nov/2026). Fonte de verdade: scripts/tokens.mjs gera daqui tailwind.css (tema do app) e o bloco de tokens de simcc.css (npm run tokens; npm run tokens:check na CI).",
  "color": {
    "brand": {
      "DEFAULT": { "$value": "#559FB8", "$description": "eng-blue: ação primária, item de menu ativo, destaque de hero" },
      "strong": { "$value": "#024A60", "$description": "eng-dark-blue: hover/pressed do primário" },
      "soft": { "$value": "#E3F0F4", "$description": "fundo suave de tags (claro)" },
      "accent-teal": { "$value": "#00757A", "$description": "sublinhado do hero da home" },
      "accent-wine": { "$value": "#9C1F2E", "$description": "ênfase pontual do hero da home" }
    },
    "logo": {
      "blue": { "$value": "#174EA6" },
      "blue-2": { "$value": "#1A73E8" },
      "red": { "$value": "#ED1C24" }
    },
    "neutral": {
      "0": { "$value": "#FFFFFF" },
      "50": { "$value": "#FAFAFA" },
      "100": { "$value": "#F5F5F5" },
      "200": { "$value": "#E5E5E5" },
      "300": { "$value": "#D4D4D4" },
      "400": { "$value": "#A3A3A3" },
      "500": { "$value": "#737373" },
      "600": { "$value": "#525252" },
      "700": { "$value": "#404040" },
      "800": { "$value": "#262626" },
      "900": { "$value": "#171717" },
      "950": { "$value": "#0A0A0A" }
    },
    "decoration": {
      "DEFAULT": { "$value": "#C8D7E1", "$description": "formas dos fundos ilustrados (chevrons, balões)" },
      "soft": { "$value": "#E1EAF0" }
    },
    "role": {
      "light": {
        "frame": { "$value": "{color.neutral.100}", "$description": "moldura: topbar + sidebar" },
        "panel": { "$value": "{color.neutral.50}", "$description": "painel de conteúdo arredondado" },
        "surface": { "$value": "{color.neutral.0}", "$description": "cards, inputs, popovers" },
        "surface-muted": { "$value": "{color.neutral.100}" },
        "surface-hover": { "$value": "{color.neutral.200}" },
        "loading": { "$value": "#CBD5E1", "$description": "slate-300: bloco \"Processando\"" },
        "text": { "$value": "{color.neutral.900}" },
        "text-strong": { "$value": "#1E293B", "$description": "slate-800: títulos de hero" },
        "text-muted": { "$value": "{color.neutral.500}" },
        "text-subtle": { "$value": "{color.neutral.400}" },
        "border": { "$value": "{color.neutral.200}" },
        "ring": { "$value": "{color.brand.DEFAULT}" },
        "on-brand": { "$value": "#FFFFFF", "$description": "texto sobre a cor de marca" }
      },
      "dark": {
        "frame": { "$value": "#000000" },
        "panel": { "$value": "{color.neutral.900}" },
        "surface": { "$value": "{color.neutral.950}" },
        "surface-muted": { "$value": "{color.neutral.800}" },
        "surface-hover": { "$value": "{color.neutral.800}" },
        "loading": { "$value": "{color.neutral.700}" },
        "text": { "$value": "{color.neutral.50}" },
        "text-strong": { "$value": "{color.neutral.50}" },
        "text-muted": { "$value": "{color.neutral.400}" },
        "text-subtle": { "$value": "{color.neutral.500}" },
        "border": { "$value": "{color.neutral.800}" },
        "brand-soft": { "$value": "#0D2A33", "$description": "color.brand.soft no tema escuro" },
        "deco": { "$value": "#1F2B33", "$description": "color.decoration.DEFAULT no tema escuro" },
        "deco-soft": { "$value": "#182128", "$description": "color.decoration.soft no tema escuro" }
      }
    },
    "status": {
      "success": { "$value": "#22C55E" },
      "success-strong": { "$value": "#16A34A" },
      "warning": { "$value": "#F59E0B" },
      "danger": { "$value": "#EF4444" },
      "info": { "$value": "{color.brand.DEFAULT}" },
      "concluida": { "$value": "#6BC26B" },
      "em-andamento": { "$value": "#DBB540" }
    },
    "run-status": {
      "$description": "Estado de uma execução ou etapa (ETL no console). Sempre acompanhado do rótulo; use como dot ou borda, não como fundo de texto.",
      "succeeded": { "$value": "{color.status.success-strong}", "$description": "Sucesso (SUCCEEDED)" },
      "failed": { "$value": "{color.status.danger}", "$description": "Falha (FAILED)" },
      "running": { "$value": "{color.status.info}", "$description": "Em execução (RUNNING)" },
      "queued": { "$value": "{color.status.warning}", "$description": "Na fila (PENDING, ACCEPTED)" }
    },
    "search-type": {
      "$description": "Cor de identidade de cada tipo de busca: swatch do seletor, chips de termo, botão de buscar, ranking.",
      "profile": { "$value": "#1D4ED8", "$description": "Perfil do pesquisador (padrão)" },
      "article": { "$value": "#3B82F6" },
      "book": { "$value": "#EC4899" },
      "patent": { "$value": "#06B6D4" },
      "software": { "$value": "#0D9488" },
      "speaker": { "$value": "#F97316", "$description": "Participação em eventos" },
      "area": { "$value": "#22C55E", "$description": "Áreas de especialidade" },
      "name": { "$value": "#EF4444" },
      "abstract": { "$value": "#EAB308" },
      "maria": { "$value": "{color.brand.DEFAULT}", "$description": "Pesquisa com IA (MarIA)" }
    },
    "great-area": {
      "agrarias": { "$value": "#F87171", "$description": "CIÊNCIAS AGRÁRIAS" },
      "exatas": { "$value": "#4ADE80", "$description": "CIÊNCIAS EXATAS E DA TERRA" },
      "saude": { "$value": "#20BDBE", "$description": "CIÊNCIAS DA SAÚDE" },
      "humanas": { "$value": "#F5831F", "$description": "CIÊNCIAS HUMANAS" },
      "biologicas": { "$value": "#EB008B", "$description": "CIÊNCIAS BIOLÓGICAS" },
      "engenharias": { "$value": "#FCB712", "$description": "ENGENHARIAS" },
      "sociais": { "$value": "#009245", "$description": "CIÊNCIAS SOCIAIS APLICADAS" },
      "linguistica": { "$value": "#A67C52", "$description": "LINGUÍSTICA, LETRAS E ARTES" },
      "outros": { "$value": "#1B1464", "$description": "OUTROS" }
    },
    "production": {
      "artigo": { "$value": "#5F82ED" },
      "livro-capitulo": { "$value": "#D15697" },
      "livro": { "$value": "#792F4C" },
      "capitulo": { "$value": "#DBAFD0" },
      "patente": { "$value": "#66B4D0" },
      "software": { "$value": "#096670" },
      "marca": { "$value": "#1B1464" },
      "relatorio-tecnico": { "$value": "#662D91" },
      "congresso": { "$value": "#FF5800" },
      "simposio": { "$value": "#D53A2C" },
      "seminario": { "$value": "#FFBD7B" },
      "oficina": { "$value": "#FCEE21" },
      "texto-revista": { "$value": "#E9A700", "$description": "Texto em jornal ou revista (cor do legado)" },
      "trabalho-evento": { "$value": "#DE2834", "$description": "Trabalho em evento (cor do legado)" }
    },
    "orientation": {
      "iniciacao-cientifica": { "$value": "#8BFBD3" },
      "mestrado": { "$value": "#67A896" },
      "doutorado": { "$value": "#425450" },
      "tcc": { "$value": "#77D2B6" },
      "outra-natureza": { "$value": "#577E74" },
      "monografia": { "$value": "#2F7F7C" },
      "pos-doutorado": { "$value": "#46724B" }
    },
    "qualis": {
      "A1": { "$value": "#34663C" },
      "A2": { "$value": "#9DC356" },
      "A3": { "$value": "#B1C38A" },
      "A4": { "$value": "#BEC4B3" },
      "B1": { "$value": "#D56438" },
      "B2": { "$value": "#DD883D" },
      "B3": { "$value": "#E3B081" },
      "B4": { "$value": "#E3AC96" },
      "C": { "$value": "#CE3830" },
      "SQ": { "$value": "#4A1314" }
    },
    "bolsa": {
      "PQ": { "$value": "#00D000" },
      "DT": { "$value": "#183EFF" }
    },
    "gender": {
      "feminino": { "$value": "#D15697" },
      "masculino": { "$value": "#5F82ED" }
    },
    "chart-neutral": {
      "1": { "$value": "#213E59" },
      "2": { "$value": "#354E68" },
      "3": { "$value": "#485F78" },
      "4": { "$value": "#5C7188" },
      "5": { "$value": "#6F8399" },
      "6": { "$value": "#98A8BA" }
    },
    "index-level": {
      "a-plus": { "$value": "#22C55E", "$description": "Nível A+" },
      "a": { "$value": "#4ADE80", "$description": "Nível A" },
      "b-plus": { "$value": "#FACC15", "$description": "Nível B+" },
      "b": { "$value": "#FDE047", "$description": "Nível B" },
      "c-plus": { "$value": "#FB923C", "$description": "Nível C+" },
      "c": { "$value": "#FDBA74", "$description": "Nível C" },
      "d-plus": { "$value": "#F87171", "$description": "Nível D+" },
      "d": { "$value": "#FCA5A5", "$description": "Nível D" },
      "e-plus": { "$value": "#A3A3A3", "$description": "Nível E+" },
      "e": { "$value": "#D4D4D4", "$description": "Nível E" }
    }
  },
  "font": {
    "family": {
      "sans": { "$value": "\"Lexend\", ui-sans-serif, system-ui, sans-serif", "$description": "tema do app (--font-sans)" },
      "sans-kit": { "$value": "\"Lexend\", ui-sans-serif, system-ui, -apple-system, sans-serif", "$description": "simcc.css (--sc-font); difere de sans só por -apple-system" }
    },
    "weight": { "light": { "$value": 300 }, "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 }, "bold": { "$value": 700 } },
    "size": {
      "2xs": { "$value": "0.625rem", "$description": "10px: kbd, micro rótulos" },
      "xs": { "$value": "0.75rem" },
      "sm": { "$value": "0.875rem", "$description": "corpo de UI" },
      "base": { "$value": "1rem" },
      "lg": { "$value": "1.125rem" },
      "xl": { "$value": "1.25rem", "$description": "título de página" },
      "2xl": { "$value": "1.5rem", "$description": "KPI" },
      "3xl": { "$value": "1.875rem" },
      "hero": { "$value": "clamp(1.875rem, 1.2rem + 2.6vw, 3rem)", "$description": "text-3xl → md:text-5xl" }
    },
    "line-height": { "hero": { "$value": 1.1 } },
    "letter-spacing": { "hero": { "$value": "-0.05em" } }
  },
  "radius": {
    "sm": { "$value": "4px" },
    "md": { "$value": "6px", "$description": "padrão: botões, inputs, chips, badges" },
    "lg": { "$value": "8px", "$description": "cards" },
    "xl": { "$value": "12px", "$description": "painel de conteúdo" },
    "full": { "$value": "9999px" }
  },
  "space": {
    "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" }, "4": { "$value": "16px" },
    "5": { "$value": "20px" }, "6": { "$value": "24px" }, "8": { "$value": "32px" }, "10": { "$value": "40px" }, "12": { "$value": "48px" }
  },
  "breakpoint": {
    "2xl": { "$value": "120rem", "$description": "1920px; sm, md, lg e xl são os padrões do Tailwind" }
  },
  "layout": {
    "topbar-height": { "$value": "40px" },
    "crumbbar-height": { "$value": "68px" },
    "sidebar-width": { "$value": "16rem" },
    "sidebar-width-icon": { "$value": "3rem" },
    "content-max": { "$value": "1200px" },
    "gutter": { "$value": "32px", "$description": "16px abaixo de 768px" }
  },
  "shadow": {
    "sm": { "$value": "0 1px 2px 0 rgb(0 0 0 / 0.05)", "$description": "apenas tab ativa" },
    "md": { "$value": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)", "$description": "avatar de perfil" },
    "lg": { "$value": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)", "$description": "popovers e modais" }
  },
  "motion": {
    "duration": { "$value": "150ms" },
    "easing": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)" }
  }
}
