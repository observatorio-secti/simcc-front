# Copie para .env e ajuste os valores. As variáveis abaixo são as que
# src/config/env.ts valida, mais VITE_BASE_PATH, lida pelo vite.config.ts.
# Os valores de produção estão nos comentários; o deploy (deploy-obs.yaml)
# passa as URLs como --build-arg, que vencem o .env.
#
# ATENÇÃO: toda variável VITE_* é embutida no JavaScript enviado ao navegador,
# ou seja, é PÚBLICA. Nunca coloque aqui chave de API, segredo ou token.

# Subcaminho onde o front é servido. Produção: /simcc/ (padrão do Dockerfile).
VITE_BASE_PATH=/

# API de consultas acadêmicas (simcc-back). A v2 fica em <url>v2/.
# Obrigatória. Produção: https://observatoriocti.secti.ba.gov.br/simcc/api/
VITE_SIMCC_API_URL=http://localhost:8088/

# API ODA (grupos de pesquisa). Produção: https://observatoriocti.secti.ba.gov.br/oda/v1/
VITE_ODA_API_URL=

# API administrativa (console: acesso de admin via /me e ações do ETL). Produção: https://observatoriocti.secti.ba.gov.br/simcc/admin/
VITE_ADMIN_API_URL=

# Provedor de identidade (login via OAuth 2.0 PKCE). Produção: https://observatoriocti.secti.ba.gov.br/idp/
VITE_IDP_URL=

# API da MarIA (validada, ainda sem uso: a T10 está bloqueada).
# Local: http://127.0.0.1:8020/. Produção: https://observatoriocti.secti.ba.gov.br/api-maria/
VITE_MARIA_API_URL=

# Google Analytics 4 (opcional; sem ele não há analytics). ID de medição,
# ex.: G-XXXXXXXXXX. Em produção, vem do .env do servidor.
VITE_GA_MEASUREMENT_ID=
