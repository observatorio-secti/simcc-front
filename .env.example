# Copie para .env e ajuste os valores.
#
# ATENÇÃO: toda variável VITE_* é embutida no JavaScript enviado ao navegador,
# ou seja, é PÚBLICA. Nunca coloque aqui chave de API, segredo ou token.

# Subcaminho onde o front é servido (produção: /simcc/).
VITE_BASE_PATH=/

# API de consultas acadêmicas (simcc-back). A v2 fica em <url>v2/.
# Obrigatória. Produção: https://observatoriocti.secti.ba.gov.br/simcc/api/
VITE_SIMCC_API_URL=http://localhost:8000/

# API ODA (grupos de pesquisa). Produção: https://observatoriocti.secti.ba.gov.br/oda/v1/
VITE_ODA_API_URL=

# API administrativa (console). Produção: https://observatoriocti.secti.ba.gov.br/simcc/admin/
VITE_ADMIN_API_URL=

# Provedor de identidade (login via OAuth 2.0 PKCE). Produção: https://observatoriocti.secti.ba.gov.br/idp/
VITE_IDP_URL=

# API do ETL (console). Autenticada pelo token do IdP, nunca por chave no front.
VITE_ETL_API_URL=

# API da MarIA. Produção: https://observatoriocti.secti.ba.gov.br/api-maria/
VITE_MARIA_API_URL=

# Google Analytics 4 (opcional). ID de medição, ex.: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=
