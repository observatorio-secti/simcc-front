# API pública de consultas acadêmicas (simcc-back)
VITE_URL_GERAL=http://localhost:8000/

# API administrativa acadêmica (simcc-admin)
VITE_URL_ADMIN=http://localhost:8009/

# Observatório IdP (Provedor central de identidade e SSO via OAuth 2.0 PKCE)
VITE_URL_IDP=https://observatoriocti.secti.ba.gov.br/idp/

# API independente da MarIA (observatorio-maria). Libere a origem deste front
# em CORS_ORIGINS da Maria quando estiverem em portas/domínios diferentes.
VITE_URL_MARIA=http://127.0.0.1:9002/

# API secundária ODA (opcional)
VITE_URL_GERAL2=https://observatoriocti.secti.ba.gov.br/oda/v1/

# URL canônica do site
VITE_URL_SITE=http://localhost:5173

# Google Analytics 4 (opcional)
VITE_GA4_PROPERTY_ID=
